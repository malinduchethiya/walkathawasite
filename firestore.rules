rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Security Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Zero-lookup admin check safe for O(1) allow list queries (strictly enforces email_verified == true)
    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'merlinfiverr0@gmail.com';
    }

    // Full admin check for single-document get/create/update/delete operations
    function isAdmin() {
      return isBootstrappedAdmin()
        || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidCategory(category) {
      return category is string && category.size() >= 1 && category.size() <= 40;
    }

    function isValidImageUrl(url) {
      return url is string
        && url.size() <= 1000
        && (url == '' || url.matches('^https://.*') || url.matches('^/.*'));
    }

    function isValidStatus(status) {
      return status is string && status in ['draft', 'published'];
    }

    function parentStory(storyId) {
      return get(/databases/$(database)/documents/stories/$(storyId)).data;
    }

    function parentStoryAfter(storyId) {
      return getAfter(/databases/$(database)/documents/stories/$(storyId)).data;
    }

    // --- Validation Blueprints (Synchronized verbatim with firebase-blueprint.json) ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'handle',
          'bio',
          'photoURL',
          'isVerified',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'handle',
          'bio',
          'photoURL',
          'isVerified',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.handle is string && data.handle.size() >= 2 && data.handle.size() <= 32 && data.handle.matches('^[a-zA-Z0-9_\\-]+$')
        && data.bio is string && data.bio.size() <= 280
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.isVerified is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBookmark(data, userId, storyId) {
      return data.keys().hasAll(['uid', 'storyId', 'storyTitle', 'storyCategory', 'createdAt'])
        && data.keys().hasOnly(['uid', 'storyId', 'storyTitle', 'storyCategory', 'createdAt'])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid && isValidId(data.uid)
        && data.storyId is string && data.storyId == storyId && isValidId(data.storyId)
        && data.storyTitle is string && data.storyTitle.size() >= 1 && data.storyTitle.size() <= 140
        && data.storyCategory is string && data.storyCategory.size() >= 1 && data.storyCategory.size() <= 40
        && data.createdAt is timestamp;
    }

    function isValidCategoryRecord(data) {
      return data.keys().hasAll(['name', 'slug', 'createdBy', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'slug', 'createdBy', 'status', 'createdAt', 'updatedAt'])
        && isValidCategory(data.name)
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 60 && data.slug.matches('^[a-z0-9_\\-]+$')
        && data.createdBy is string && isValidId(data.createdBy)
        && data.status is string && data.status == 'active'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSiteSeoSettings(data) {
      return data.keys().hasAll(['siteTitle', 'metaDescription', 'keywords', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['siteTitle', 'metaDescription', 'keywords', 'updatedBy', 'updatedAt'])
        && data.siteTitle is string && data.siteTitle.size() >= 1 && data.siteTitle.size() <= 140
        && data.metaDescription is string && data.metaDescription.size() >= 1 && data.metaDescription.size() <= 320
        && data.keywords is string && data.keywords.size() >= 1 && data.keywords.size() <= 2000
        && data.updatedBy is string && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidStory(data) {
      return data.keys().hasAll([
          'title',
          'excerpt',
          'category',
          'authorId',
          'authorName',
          'authorPhotoURL',
          'authorVerified',
          'views',
          'chapterCount',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'title',
          'excerpt',
          'category',
          'coverImageURL',
          'authorId',
          'authorName',
          'authorPhotoURL',
          'authorVerified',
          'views',
          'chapterCount',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
        && data.excerpt is string && data.excerpt.size() >= 10 && data.excerpt.size() <= 320
        && isValidCategory(data.category)
        && (!('coverImageURL' in data) || isValidImageUrl(data.coverImageURL))
        && data.authorId is string && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60
        && data.authorPhotoURL is string && data.authorPhotoURL.size() <= 500
        && data.authorVerified is bool
        && data.views is int && data.views >= 0 && data.views <= 100000000
        && data.chapterCount is int && data.chapterCount >= 1 && data.chapterCount <= 200
        && isValidStatus(data.status)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChapter(data, storyId) {
      return data.keys().hasAll([
          'storyId',
          'authorId',
          'status',
          'chapterNumber',
          'title',
          'content',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'storyId',
          'authorId',
          'status',
          'chapterNumber',
          'title',
          'content',
          'imageURL',
          'createdAt',
          'updatedAt'
        ])
        && data.storyId is string && data.storyId == storyId && isValidId(data.storyId)
        && data.authorId is string && isValidId(data.authorId)
        && isValidStatus(data.status)
        && data.chapterNumber is int && data.chapterNumber >= 1 && data.chapterNumber <= 200
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.content is string && data.content.size() >= 20 && data.content.size() <= 25000
        && (!('imageURL' in data) || isValidImageUrl(data.imageURL))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidComment(data, storyId) {
      return data.keys().hasAll(['storyId', 'authorId', 'authorName', 'body', 'status', 'createdAt'])
        && data.keys().hasOnly(['storyId', 'authorId', 'authorName', 'body', 'status', 'createdAt'])
        && data.storyId is string && data.storyId == storyId && isValidId(data.storyId)
        && data.authorId is string && data.authorId == request.auth.uid && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 1000
        && data.status is string && data.status == 'visible'
        && data.createdAt is timestamp;
    }

    // --- Collection 0: Admin Registry (Server-only writes, owner read) ---
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isOwner(adminId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // --- Collection 0b: Global Site SEO Settings (Public Get, Admin Write) ---
    match /siteSettings/{settingId} {
      allow get: if settingId == 'seo';
      allow list: if false;
      allow create: if isAdmin()
        && settingId == 'seo'
        && isValidSiteSeoSettings(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && settingId == 'seo'
        && isValidSiteSeoSettings(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'siteTitle',
          'metaDescription',
          'keywords',
          'updatedBy',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // --- Collection 1: Public Author Profiles (Zero PII) ---
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().isVerified == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().isVerified == existing().isVerified
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'handle',
          'bio',
          'photoURL',
          'updatedAt'
        ]);
      allow delete: if false;

      // Subcollection: Owner-only Saved Story Bookmarks
      match /bookmarks/{storyId} {
        allow get: if isValidId(userId) && isValidId(storyId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().uid == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(storyId)
          && isOwner(userId)
          && isValidBookmark(incoming(), userId, storyId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if false;
        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(storyId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));
      }
    }

    // --- Collection 2: Private User PII (Strict Owner Isolation) ---
    match /userPrivate/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPrivate(incoming(), userId)
        && incoming().email == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPrivate(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().email == request.auth.token.email
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
      allow delete: if false;
    }

    // --- Collection 3: Custom Story Categories (Public Read, Admin Write) ---
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if existing().status == 'active';
      allow create: if isAdmin()
        && isValidId(categoryId)
        && isValidCategoryRecord(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(categoryId)
        && isValidCategoryRecord(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().status == existing().status
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    // --- Collection 4: Stories ---
    match /stories/{storyId} {
      allow get: if isValidId(storyId)
        && (
          existing().status == 'published'
          || (isSignedIn() && existing().authorId == request.auth.uid)
          || isAdmin()
        );
      allow list: if existing().status == 'published'
        || (isSignedIn() && existing().authorId == request.auth.uid)
        || isBootstrappedAdmin();
      allow create: if isVerifiedUser()
        && isValidId(storyId)
        && isValidStory(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            incoming().views == 0
            && incoming().authorVerified == false
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          )
          || isAdmin()
        );
      allow update: if isVerifiedUser()
        && isValidId(storyId)
        && isValidStory(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && (
          // Action 1: Author edits own story metadata or publication status
          (
            existing().authorId == request.auth.uid
            && incoming().authorVerified == existing().authorVerified
            && incoming().views == existing().views
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'excerpt',
              'category',
              'coverImageURL',
              'authorName',
              'authorPhotoURL',
              'chapterCount',
              'status',
              'updatedAt'
            ])
          )
          ||
          // Action 2: Verified reader increments view count by exactly 1
          (
            existing().status == 'published'
            && incoming().authorVerified == existing().authorVerified
            && incoming().views == existing().views + 1
            && incoming().updatedAt == existing().updatedAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['views'])
          )
          ||
          // Action 3: Verified administrator manages any story
          (
            isAdmin()
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'excerpt',
              'category',
              'coverImageURL',
              'authorName',
              'authorPhotoURL',
              'authorVerified',
              'views',
              'chapterCount',
              'status',
              'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser()
        && isValidId(storyId)
        && (existing().authorId == request.auth.uid || isAdmin());

      // Subcollection: Story Chapters / Parts
      match /chapters/{chapterId} {
        allow get: if isValidId(storyId)
          && isValidId(chapterId)
          && exists(/databases/$(database)/documents/stories/$(storyId))
          && (
            parentStory(storyId).status == 'published'
            || (isSignedIn() && parentStory(storyId).authorId == request.auth.uid)
            || isAdmin()
          );
        allow list: if existing().status == 'published'
          || (isSignedIn() && existing().authorId == request.auth.uid)
          || isBootstrappedAdmin();
        allow create: if isVerifiedUser()
          && isValidId(storyId)
          && isValidId(chapterId)
          && isValidChapter(incoming(), storyId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/stories/$(storyId))
          && incoming().status == parentStoryAfter(storyId).status
          && (
            (
              incoming().authorId == request.auth.uid
              && parentStoryAfter(storyId).authorId == request.auth.uid
            )
            ||
            (
              isAdmin()
              && (
                incoming().authorId == parentStoryAfter(storyId).authorId
                || incoming().authorId == request.auth.uid
              )
            )
          );
        allow update: if isVerifiedUser()
          && isValidId(storyId)
          && isValidId(chapterId)
          && isValidChapter(incoming(), storyId)
          && incoming().storyId == existing().storyId
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/stories/$(storyId))
          && (parentStory(storyId).authorId == request.auth.uid || isAdmin())
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'chapterNumber',
            'title',
            'content',
            'imageURL',
            'status',
            'updatedAt'
          ]);
        allow delete: if isVerifiedUser()
          && isValidId(storyId)
          && isValidId(chapterId)
          && exists(/databases/$(database)/documents/stories/$(storyId))
          && (parentStory(storyId).authorId == request.auth.uid || isAdmin());
      }

      // Subcollection: Story Comments
      match /comments/{commentId} {
        allow get: if isValidId(storyId)
          && isValidId(commentId)
          && exists(/databases/$(database)/documents/stories/$(storyId))
          && (parentStory(storyId).status == 'published' || isAdmin());
        allow list: if existing().status == 'visible' || isBootstrappedAdmin();
        allow create: if isVerifiedUser()
          && isValidId(storyId)
          && isValidId(commentId)
          && isValidComment(incoming(), storyId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/stories/$(storyId))
          && parentStory(storyId).status == 'published';
        allow update: if false;
        allow delete: if isVerifiedUser()
          && isValidId(storyId)
          && isValidId(commentId)
          && exists(/databases/$(database)/documents/stories/$(storyId))
          && (
            existing().authorId == request.auth.uid
            || parentStory(storyId).authorId == request.auth.uid
            || isAdmin()
          );
      }
    }
  }
}
